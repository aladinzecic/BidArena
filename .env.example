# Kopiraj u .env (cp .env.example .env) i zameni sve CHANGE_ME vrednosti.
# .env je u .gitignore i NIKAD ne sme u repozitorijum.

# --- PostgreSQL (servis "db") ---
POSTGRES_DB=bidarena
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_db_password

# --- API (servis "api") ---
# Host je ime compose servisa ("db"), ne localhost.
# Lozinka ovde mora biti ista kao POSTGRES_PASSWORD gore.
# Izbegavaj ; i = u lozinci, jer su to separatori u connection string-u.
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=bidarena;Username=postgres;Password=CHANGE_ME_db_password

# Tajni ključ za potpisivanje JWT-a (HMAC-SHA256): najmanje 32 nasumična karaktera.
# Generisanje: openssl rand -base64 48
Jwt__Key=CHANGE_ME_generate_with_openssl_rand_base64_48
Jwt__Issuer=BidArena
Jwt__Audience=BidArena.Client

# Primena EF migracija pri startu kontejnera (u aplikaciji je podrazumevano false).
Database__MigrateOnStartup=true

# Port na hostu na koji se mapira API (u kontejneru je 8080).
API_PORT=8080
